# DeepFlow version to deploy
DEEPFLOW_VERSION=v7.1

# IP address of the host machine where DeepFlow Server is running.
#
#   - DeepFlow agent needs this IP to connect to deepflow-server
#     via port 30035 (gRPC control plane) and 30033 (data plane)
#   - Use the IP from a network interface that is reachable by
#     other agents in your network
NODE_IP_FOR_DEEPFLOW=